# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only PUBLIC values belong here. Never add the service_role / sb_secret key:
# the app does not need it and the browser bundle must never contain it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional — Super Admin "Book Meeting" action. Leave empty to hide the button.
NEXT_PUBLIC_CALENDLY_URL=

# --- Free Report email notifications (SERVER-SIDE ONLY) ----------------------
# Used only by /api/free-report/notify. Never prefix these with NEXT_PUBLIC_.
# Set them in Vercel → Project → Settings → Environment Variables.
# Resend API key (https://resend.com/api-keys) — secret.
RESEND_API_KEY=
# Sender address. Its domain must be verified in Resend, e.g.
# SignalReach <notifications@signalreach.live>
EMAIL_FROM=
# Optional — IANA timezone for the submission date/time in the email. Defaults to UTC.
NOTIFY_TIMEZONE=
